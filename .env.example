# BountyRoast Production Environment Variables

# 1. Supabase (Database, Realtime & Auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# 2. Stripe Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# 3. Stripe Webhooks (Optional in dev, required in production)
# Generated in Stripe Dashboard -> Webhooks -> Add Endpoint (https://your-domain.vercel.app/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
